# ╔══════════════════════════════════════════════════════╗
# ║  AIOS — Variables d'environnement (MODÈLE)            ║
# ║  Copier en .env et remplir. NE JAMAIS committer .env. ║
# ╚══════════════════════════════════════════════════════╝

# ── Base de données — Supabase PostgreSQL + pgvector (GRATUIT) ──
# Supabase > Project Settings > Database > Connection string (pooler)
DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require

# ── Redis — Upstash (GRATUIT) ──
REDIS_URL=rediss://default:TOKEN@xxxx.upstash.io:6379

# ── Uploads (sans Docker) ── en prod, préférer Supabase Storage
UPLOAD_DIR=./uploads

# ── LLM texte — bascule Groq (en ligne) <-> Ollama (local) ──
# Pilotés par la librairie `openai` (endpoints compatibles), Module E inclus.
# Règle : USE_LOCAL_LLM=true OU GROQ_API_KEY vide -> Ollama local automatiquement.
GROQ_API_KEY=REMPLACER_ICI                  # https://console.groq.com (laisser vide = 100% local)
GROQ_MODEL=llama-3.3-70b-versatile
USE_LOCAL_LLM=false                         # true pour forcer Ollama même si une clé Groq existe
OLLAMA_BASE_URL=http://localhost:11434      # serveur Ollama local (ex: `ollama serve`)
OLLAMA_MODEL=llama3.1                       # modèle Ollama (ex: `ollama pull llama3.1`)
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # surcharge avancée (rare)

# ── Embeddings (recherche sémantique Module B) ──
# EMBEDDING_PROVIDER : local (défaut, fastembed, GRATUIT, sans clé, hors-ligne)
#                      | gemini | openai | ollama
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # surcharge le modèle fastembed local
# OPENAI_API_KEY=                          # si EMBEDDING_PROVIDER=openai (payant)
# GEMINI_API_KEY=                          # si EMBEDDING_PROVIDER=gemini (clé AI Studio "AIza...")

# ── Module K — Veille réglementaire (optionnel) ──
# Flux RSS/Atom keyless à surveiller (séparés par des virgules). Vide = mode "sample" seulement.
# VEILLE_RSS_URLS=https://example.com/flux1.rss,https://example.com/flux2.atom

# ── Auth — Supabase Auth (GRATUIT jusqu'à 50k users) ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=REMPLACER_ICI_service_role
SUPABASE_ANON_KEY=REMPLACER_ICI_anon

# ── Emails — Resend (GRATUIT 3 000/mois) ──
# En test, utiliser onboarding@resend.dev tant que le domaine n'est pas vérifié.
RESEND_API_KEY=REMPLACER_ICI
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Cabinet Juridique
EMAIL_AVOCAT=avocat@cabinet.fr

# ── Email OAuth2 (Gmail) — Google Cloud Console > Credentials ──
# Redirect URI à autoriser : http://localhost:8000/api/email/callback/google
GOOGLE_CLIENT_ID=REMPLACER_ICI.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REMPLACER_ICI
BACKEND_URL=http://localhost:8000

# ── Application ──
# Générer une vraie clé : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_32_OCTETS
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
# Création de dossier depuis un email entrant : "propose" (validation avocat, défaut) | "auto"
EMAIL_DOSSIER_MODE=propose

# ── Monitoring LLM — Langfuse (optionnel, self-host gratuit) ──
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
